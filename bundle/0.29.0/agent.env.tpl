# Настройки агента. Права 600, владелец root.
#
# Здесь токен доступа к API агента и параметры уведомлений — SMTP и токен
# бота Telegram. Всё это пользователь вводит в приложении, всё это живёт в
# хранилище ОС его машины, и ничего из этого не уходит на backend
# разработчика. Ровно то же правило, что и у секретов стека.
#
# Файл читает docker compose (`env_file`) и передаёт агенту переменными
# окружения. Список сайтов сюда не попадает: он меняется куда чаще и лежит
# отдельным файлом, чтобы новый домен не стоил перезапуска агента.

# Токен API агента. Без него агент отказывается стартовать: внутри
# docker-сети рядом стоят чужие по смыслу контейнеры, и открытый API
# доступен им всем.
AGENT_TOKEN={{ AGENT_TOKEN }}

# ── Хук «я задеплоил» ────────────────────────────────────────────────────
# Токен, которым деплой-скрипт клиента просит агента сходить по ключевым
# адресам прямо сейчас: POST /deployed на петле сервера.
#
# Токен отдельный от AGENT_TOKEN, и это решение, а не удобство. Строку с ним
# человек вставляет в свой деплой-скрипт, а тот живёт в репозитории. Токен
# API открывает всё, что агент знает о клиентах агентства; этот — только
# «сходи по ключевым адресам». Пусто — хук выключен целиком.
DEPLOY_TOKEN={{ DEPLOY_TOKEN }}

# ── Ключевые адреса проектов ─────────────────────────────────────────────
# Как часто ходить по ним (в минутах) и сколько ждать ответа (в секундах).
#
# Это чужой прод: каждая минута означала бы триста запросов в сутки на
# каждый адрес. Проверка идёт с самого сервера и потому отвечает на вопрос
# «приложение отвечает», а не «посетитель это видит»: облачный файрвол
# провайдера отсюда не виден — за этим есть внешняя проверка.
PROBE_INTERVAL_MINUTES={{ PROBE_INTERVAL_MINUTES }}
PROBE_TIMEOUT_SECONDS={{ PROBE_TIMEOUT_SECONDS }}

# ── Почта ─────────────────────────────────────────────────────────────────
# Пусто — письма не отправляются. Порт 465 означает TLS с первого байта,
# остальные — STARTTLS, если сервер его предлагает.
SMTP_HOST={{ SMTP_HOST }}
SMTP_PORT={{ SMTP_PORT }}
SMTP_USER={{ SMTP_USER }}
SMTP_PASSWORD={{ SMTP_PASSWORD }}
SMTP_FROM={{ SMTP_FROM }}
# Получатели через запятую.
SMTP_TO={{ SMTP_TO }}

# ── Telegram ──────────────────────────────────────────────────────────────
# Пусто — сообщения не отправляются. Настроены оба канала — уведомление
# уходит в оба: выбирать за агентство, что важнее, мы не станем.
TELEGRAM_BOT_TOKEN={{ TELEGRAM_BOT_TOKEN }}
TELEGRAM_CHAT_ID={{ TELEGRAM_CHAT_ID }}

# ── Выключатель уведомлений этого сервера ────────────────────────────────
# Каналы выше общие на все серверы, а писать должен не каждый. Строку
# NOTIFY_MUTED=1 дописывает в конец файла приложение, когда человек снял
# галочку у этого сервера: агент продолжает следить, но не шлёт ни тревог,
# ни недельного отчёта. Ключа нет или он пуст — уведомления включены.
#
# Здесь его нет намеренно: новая подстановка в шаблоне уронила бы установку
# у сборок приложения, которые вышли раньше и значения для неё не знают.

# ── Slack, Discord и вебхук ──────────────────────────────────────────────
# Ещё три канала (агент 0.21.0). Каждый — секретный адрес, на который агент
# шлёт сообщение POST-запросом: «входящий вебхук» Slack, вебхук канала
# Discord или произвольный адрес (ntfy, свой скрипт). Бота заводить не надо.
#
# Строки SLACK_WEBHOOK_URL=, DISCORD_WEBHOOK_URL= и WEBHOOK_URL= дописывает в
# конец файла приложение — по той же причине, что и выключатель выше.
# Ключа нет или он пуст — канал выключен.
#
# Адрес — секрет того же разряда, что токен бота: кто его знает, тот пишет в
# чат. Принимается только https и только адрес в интернете: на сам сервер и
# в его внутреннюю сеть агент по такому адресу не пойдёт, перенаправлений не
# выполняет. Негодный адрес агент считает выключенным каналом.

# ── Пороги ────────────────────────────────────────────────────────────────
# При каком заполнении диска пора беспокоить и за сколько дней
# предупреждать об истечении сертификата и домена.
ALERT_DISK_PERCENT={{ ALERT_DISK_PERCENT }}
ALERT_CERT_DAYS={{ ALERT_CERT_DAYS }}

# Домен — ступенями через запятую, от дальней к ближней: «30,14,7,1».
# Письмо уходит один раз на каждой ступени и ни одного между ними.
#
# Продлевает домен человек у регистратора, и до этого дня нашими руками он
# ничего не сделает: одного порога хватало, чтобы письмо приходило каждые
# сутки все тридцать дней подряд, — а письма, которые приходят тридцать раз,
# перестают читать вместе со всеми остальными. Одно число тоже годится: это
# та же запись из одной ступени.
#
# Сертификата это не касается: его продлевает Caddy сам за тридцать дней до
# срока, и тревога за четырнадцать означает, что автопродление уже не
# сработало. Там повтор — не шум, а незакрытая беда.
ALERT_DOMAIN_DAYS={{ ALERT_DOMAIN_DAYS }}

# ── Проверка битых ссылок ────────────────────────────────────────────────
# Как часто обходить сайт (в часах), насколько глубоко ходить по ссылкам,
# сколько страниц максимум за круг и сколько запросов к сайту держать
# одновременными. Всё консервативно: это чужой прод, краулинг не должен
# мешать работе сайта. Исключения — регулярки через точку с запятой (не
# через запятую: она сама частый символ внутри регулярки, {2,4}), куда ни
# агенту не заходить, ни lychee не проверять ссылки.
LINK_CHECK_INTERVAL_HOURS={{ LINK_CHECK_INTERVAL_HOURS }}
LINK_MAX_DEPTH={{ LINK_MAX_DEPTH }}
LINK_MAX_PAGES={{ LINK_MAX_PAGES }}
# Пауза между запросами при обходе. robots.txt соблюдается всегда и
# выключателя не имеет; Crawl-delay сайта, если он больше, сильнее этого
# числа.
LINK_REQUESTS_PER_MINUTE={{ LINK_REQUESTS_PER_MINUTE }}
LINK_MAX_CONCURRENCY={{ LINK_MAX_CONCURRENCY }}
LINK_TIMEOUT_SECONDS={{ LINK_TIMEOUT_SECONDS }}
LINK_EXCLUDE={{ LINK_EXCLUDE }}

# ── Core Web Vitals ──────────────────────────────────────────────────────
# Ключ Google Cloud агентства. Он такой же секрет, как пароль от почты:
# лежит здесь, с правами 600, и на backend разработчика не уходит никогда.
# Пусто — производительность не меряется вовсе: PSI отвечает и без ключа, но
# с квотой в пару запросов, и упереться в неё молча хуже, чем сказать прямо.
#
# В проекте Google Cloud нужно включить два API: PageSpeed Insights (данные
# лаборатории) и Chrome UX Report (данные живых посетителей). Раньше вторые
# приезжали вместе с первыми, но Google это сворачивает.
VITALS_API_KEY={{ VITALS_API_KEY }}

# Как часто мерить (в часах), для каких устройств (mobile, desktop или оба
# через запятую) и сколько обращений к API тратить за сутки с этого сервера.
# Квота у ключа общая на всё агентство — 25 000 запросов в день у PSI, — и
# один сервер не должен съедать её целиком.
VITALS_INTERVAL_HOURS={{ VITALS_INTERVAL_HOURS }}
VITALS_STRATEGIES={{ VITALS_STRATEGIES }}
VITALS_DAILY_LIMIT={{ VITALS_DAILY_LIMIT }}
# Таймаут одного обращения: PSI открывает страницу настоящим браузером и
# думает десятками секунд.
VITALS_TIMEOUT_SECONDS={{ VITALS_TIMEOUT_SECONDS }}
# Потолок страниц на сайт вместе с главной.
VITALS_MAX_PAGES={{ VITALS_MAX_PAGES }}

# ── Логи веб-сервера ─────────────────────────────────────────────────────
# Агент дочитывает логи, которые уже лежат на диске, и только на чтение.
# Хранит он из них не строки, а счётчики: лог за сутки — это гигабайты на
# диске клиента, и в каждой строке access-лога стоит адрес посетителя.
#
# Как часто дочитывать (в секундах), сколько суток хранить счётчики и
# сколько байт читать за один проход с одного файла. Остаток дочитает
# следующий проход: агент не имеет права занимать сервер собой.
LOG_SCAN_INTERVAL_SECONDS={{ LOG_SCAN_INTERVAL_SECONDS }}
LOG_RETENTION_DAYS={{ LOG_RETENTION_DAYS }}
LOG_MAX_BYTES={{ LOG_MAX_BYTES }}

# Всплеск: столько ответов 5xx за окно (в минутах) — повод написать
# человеку тем же путём, что и о диске с сертификатами. Ноль выключает
# тревогу совсем, и это законный выбор.
LOG_ALERT_THRESHOLD={{ LOG_ALERT_THRESHOLD }}
LOG_ALERT_WINDOW_MINUTES={{ LOG_ALERT_WINDOW_MINUTES }}

# Столько ответов «страницы нет» за то же окно — повод показать всплеск в
# своде состояния. Порог свой и выше: четыреста четвёртая — это ещё и фон от
# ботов, перебирающих чужие админки, а пятисотка фоном не бывает.
#
# Письма по нему не уходят намеренно: пропавшая страница не должна будить
# ночью, а лишнее письмо стоит доверия ко всем остальным. Ноль выключает.
LOG_NOT_FOUND_THRESHOLD={{ LOG_NOT_FOUND_THRESHOLD }}

# Искать ли логи в известных местах (/var/log/nginx, /var/log/apache2,
# /var/log/httpd). Ноль — только те пути, что заданы в приложении. Пустое
# значение означает «искать»: приложение всегда пишет сюда 1 или 0, а на
# правку файла руками умолчание одно на все признаки агента.
LOG_AUTODISCOVER={{ LOG_AUTODISCOVER }}

# ── Обход сайта для SEO ───────────────────────────────────────
# Свой краулер агента: ходит по внутренним ссылкам и снимает с каждой
# страницы структуру — заголовки, описания, canonical, alt-тексты. Хранится
# структура, а не HTML: страница это сотня килобайт разметки, из которых
# аудиту нужен килобайт, а диск не наш.
#
# robots.txt соблюдается всегда, и выключателя у этого нет: агент — бот на
# живом сервере, пусть сайт и принадлежит агентству. Файл, который не
# отдался (5xx или обрыв связи), по RFC 9309 означает «не ходить» — обход
# в этом случае не проводится, и приложение говорит об этом прямо.
#
# 0 — обход выключен целиком: сотни запросов к чужому проду это не то, что
# делают без спроса. Пустое значение означает «включён»: приложение всегда
# пишет сюда 1 или 0, а на правку файла руками умолчание одно на все
# признаки агента.
SEO_ENABLED={{ SEO_ENABLED }}

# Как часто обходить (в часах), насколько глубоко ходить по ссылкам и
# сколько страниц максимум брать с сайта за обход.
SEO_INTERVAL_HOURS={{ SEO_INTERVAL_HOURS }}
SEO_MAX_DEPTH={{ SEO_MAX_DEPTH }}
SEO_MAX_PAGES={{ SEO_MAX_PAGES }}

# Сколько запросов в минуту разрешено сайту: отсюда считается пауза между
# обращениями. Crawl-delay из robots.txt, если он больше, заменяет её собой —
# сайт, попросивший ходить реже, важнее нашей настройки.
SEO_REQUESTS_PER_MINUTE={{ SEO_REQUESTS_PER_MINUTE }}

# Таймаут одного запроса и потолок читаемой разметки (в килобайтах).
# Остаток страницы отбрасывается, и об этом сказано в отчёте: разбирать
# мегабайт разметки незачем, а память агента не наша.
SEO_TIMEOUT_SECONDS={{ SEO_TIMEOUT_SECONDS }}
SEO_MAX_PAGE_KB={{ SEO_MAX_PAGE_KB }}

# Читать ли карту сайта (robots.txt Sitemap, иначе /sitemap.xml). В ней
# лежат страницы, на которые не ведёт ни одна ссылка, — а это ровно то, что
# аудит обязан заметить. Карте отдаётся не больше половины потолка страниц,
# иначе у магазина обход по ссылкам не состоится вовсе.
SEO_SITEMAP={{ SEO_SITEMAP }}

# Куда не ходить помимо robots.txt: регулярки через точку с запятой — не
# через запятую, по той же причине, что и у ссылок ({2,4} внутри регулярки).
SEO_EXCLUDE={{ SEO_EXCLUDE }}

# ── Еженедельный отчёт ────────────────────────────────────────────────────
#
# Раз в неделю агент рассказывает, как дела у сервера и у проектов на нём.
# Это не тревога: тревога будит, когда что-то сломалось, а отчёт отвечает на
# вопрос «за неделю ничего не пропустили?». Он уходит и тогда, когда всё в
# порядке: отчёт, замолкающий от отсутствия новостей, неотличим от агента,
# который умер.
#
# Отчёт уходит по этому серверу и называет его в теме письма. Собрать один
# отчёт на все VPS агентства может только приложение, а оно в этот момент
# закрыто — иначе письмо было бы не нужно.
#
# 0 — не отправлять. Пустое значение означает «не отправлять» тоже: письмо
# раз в неделю — это то, на что соглашаются, а не то, что включают молча.
DIGEST_ENABLED={{ DIGEST_ENABLED }}

# День недели (0 — воскресенье) и час по времени этого сервера.
# Отчёт в три ночи воскресенья бесполезен, поэтому и то и другое задаёт
# человек. Часовой пояс агент определяет сам — тот же, по которому он
# читает времена в логах веб-сервера.
DIGEST_WEEKDAY={{ DIGEST_WEEKDAY }}
DIGEST_HOUR={{ DIGEST_HOUR }}

# Язык, на котором агент пишет отчёт: ru или en.
#
# Единственное место, где у агента есть язык. Тревога раз в квартал
# остаётся русской — спросить о языке в момент аварии некого, — а
# еженедельная переписка идёт на языке того, кто её читает.
AGENT_LOCALE={{ AGENT_LOCALE }}

# ── Копия базы в хранилище клиента ───────────────────────────────────────
#
# Раз в сутки агент снимает дамп аналитики, собирает архив и кладёт его в
# S3-совместимое хранилище, которое оплачивает клиент. Мест всего три, и два
# отпадают сами: копия на том же VPS умрёт вместе с диском, а копия у нас
# нарушила бы инвариант — аналитика клиента на инфраструктуре vpsFocus не
# окажется ни при каких обстоятельствах.
#
# **Копия не шифруется, и секретов в ней нет.** `.env` и этот файл лежат с
# правами 600 и владельцем root, а агент работает под своим пользователем:
# прочитать их он не может физически. `probes.json` едет без заголовков — в
# них токены закрытых разделов. Всё остальное в копии открыто, и человеку об
# этом сказано на экране: не шифровать можно ровно потому, что второй
# невосстановимый ключ рядом с ключом подписи обновлений дороже.
#
# Пусто — копии не делаются вовсе.
BACKUP_ENABLED={{ BACKUP_ENABLED }}

# Как часто снимать копию (в часах) и сколько их держать в хранилище.
#
# Ноль в BACKUP_KEEP означает «не удалять ничего»: правилами жизненного цикла
# бакета человек вправе распорядиться сам, и затирать их нашей ротацией
# нельзя. Ротация трогает только объекты под нашим префиксом.
BACKUP_INTERVAL_HOURS={{ BACKUP_INTERVAL_HOURS }}
BACKUP_KEEP={{ BACKUP_KEEP }}

# Потолок времени на весь круг: дамп, сборка архива, выгрузка.
BACKUP_TIMEOUT_MINUTES={{ BACKUP_TIMEOUT_MINUTES }}

# Хранилище. Учётные данные — секрет того же разряда, что пароль от почты:
# живут здесь, с правами 600, и на backend разработчика не уходят никогда.
#
# Адресация (имя бакета в пути или в имени хоста) выбирается сама:
# *.amazonaws.com — поддоменом, всё остальное — путём. Спрашивать это у
# человека нельзя: ошибка выглядит как «ключ не подошёл» и уводит разбор
# совсем не туда. Пусто — решает агент; 1 или 0 — решает человек.
BACKUP_S3_ENDPOINT={{ BACKUP_S3_ENDPOINT }}
BACKUP_S3_REGION={{ BACKUP_S3_REGION }}
BACKUP_S3_BUCKET={{ BACKUP_S3_BUCKET }}
BACKUP_S3_KEY_ID={{ BACKUP_S3_KEY_ID }}
BACKUP_S3_SECRET={{ BACKUP_S3_SECRET }}
BACKUP_S3_PATH_STYLE={{ BACKUP_S3_PATH_STYLE }}

# Префикс, под которым лежат копии этого сервера. Бакет у агентства один на
# всех, и по префиксу же идёт восстановление на новый VPS: человек ищет копии
# старого сервера, а не гадает, какая из сотни чья.
BACKUP_S3_PREFIX={{ BACKUP_S3_PREFIX }}

# Каталог стека на хосте, каким его видит агент. Из него в копию едут
# docker-compose.yml, Caddyfile и версия стека — не секреты (их читает кто
# угодно на сервере), но без них человек, восстанавливающий копию руками,
# остаётся ни с чем.
BACKUP_STACK_DIR={{ BACKUP_STACK_DIR }}
