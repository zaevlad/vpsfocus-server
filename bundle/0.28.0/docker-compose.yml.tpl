# Мониторинговый стек клиента.
#
# Файл собирается приложением из этого шаблона: подставляется только
# {{ STACK_NAME }}. Всё остальное, что меняется от установки к установке,
# приезжает из .env — его docker compose читает сам. Секретов здесь нет и
# быть не может: .env лежит с правами 600 и владельцем root, а этот файл
# читается кем угодно.
#
# Версии образов зафиксированы прямо здесь, а не приходят из приложения.
# Так версия стека привязана к версии бандла: обновить Umami можно, выпустив
# новый бандл, не трогая десктоп.
#
# Все образы мультиархитектурные (amd64 и arm64) — ARM-серверы обычны у
# Hetzner и Oracle Cloud, и dry-run проверяет архитектуру именно поэтому.
#
# Образ закреплён дайджестом, а не только тегом (Б5 ревизии 2026-09-18). Тег
# в реестре перезаписываем: захваченный аккаунт реестра подменил бы образ на
# всех серверах клиентов при ближайшей установке или обновлении, а дайджест
# — нет. Тег оставлен рядом для людей, docker его при дайджесте не смотрит.
# Дайджест — индекса со всеми архитектурами, а не одной из них.
#
# Свои образы (агент и Caddy) закрепляются после публикации: дайджест им
# выдаёт реестр. `build.ps1 -Push` записывает закреплённую ссылку в
# `published.txt` рядом с собой, и с этого момента тест
# `image_tags_match_the_build_scripts` требует её здесь.

name: {{ STACK_NAME }}

services:
  # ── База ────────────────────────────────────────────────────────────────
  # Наружу не публикуется вообще: ни на 0.0.0.0, ни на 127.0.0.1. Достучаться
  # до неё можно только из нашей же docker-сети.
  postgres:
    image: postgres:17.6-alpine@sha256:ef257d85f76e48da1c64832459b59fcaba1a4dac97bf5d7450c77753542eee94
    restart: unless-stopped
    environment:
      POSTGRES_DB: umami
      POSTGRES_USER: umami
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD:?}
      # Инициализация базы с явной локалью: без этого образ берёт настройки
      # хоста, и одинаковый стек на двух серверах сортирует данные по-разному.
      POSTGRES_INITDB_ARGS: "--encoding=UTF8 --locale=C"
    volumes:
      - postgres-data:/var/lib/postgresql/data
    networks:
      - internal
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U umami -d umami"]
      interval: 5s
      timeout: 5s
      retries: 30
      start_period: 20s

  # ── Аналитика ───────────────────────────────────────────────────────────
  # Публикуется только на петлю: админка Umami из интернета не нужна никогда,
  # приложение ходит в неё через SSH-туннель. Порт нестандартный намеренно —
  # 3000 на чужом сервере занят слишком часто.
  umami:
    image: ghcr.io/umami-software/umami:postgresql-3.0.0@sha256:818105b05d6b460d5526b2d426017fa1664025e87b1a4f03770b613df5fca6e1
    restart: unless-stopped
    environment:
      DATABASE_TYPE: postgresql
      DATABASE_URL: postgresql://umami:${POSTGRES_PASSWORD:?}@postgres:5432/umami
      APP_SECRET: ${UMAMI_APP_SECRET:?}
      # Мы стоим на проде клиента и обещаем, что наружу уходит только то, без
      # чего нельзя. Оба обращения к umami.is выключены.
      DISABLE_TELEMETRY: "1"
      DISABLE_UPDATES: "1"
    ports:
      - "127.0.0.1:${UMAMI_HOST_PORT:?}:3000"
    networks:
      - internal
    depends_on:
      postgres:
        condition: service_healthy
    healthcheck:
      # В образе нет ни curl, ни wget — проверяем тем, на чём Umami написан.
      test:
        - CMD
        - node
        - -e
        - "fetch('http://127.0.0.1:3000/api/heartbeat').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
      interval: 10s
      timeout: 5s
      retries: 30
      start_period: 30s

  # ── Агент ───────────────────────────────────────────────────────────────
  # Следит за самим сервером и за сроками доменов и сертификатов, а когда
  # что-то не так — пишет письмо или в Telegram сам, с этого сервера.
  # Приложение агентства может быть закрыто неделю, беда от этого не ждёт.
  #
  # Публикуется только на петлю, как и Umami: приложение ходит к нему через
  # SSH-туннель, снаружи его не существует.
  agent:
    image: ghcr.io/zaevlad/vpsfocus-agent:0.23.0@sha256:c65b6d6cd8c7d13b171e352475f96c5cdc40338b9c4cf5815f0ab1540253cb03
    restart: unless-stopped
    # Ни одной привилегии сверх необходимого (Б6 ревизии 2026-09-18). Агент
    # работает под uid 10001 и не делает ничего, для чего нужны capabilities:
    # слушает порт выше 1024, читает смонтированное и ходит по сети. Ни у
    # него, ни у lychee с pg_dump нет setuid-бита, поэтому no-new-privileges
    # ничего не ломает, а путь «баг в контейнере → права на хосте» закрывает.
    #
    # `read_only` здесь не стоит: pg_dump и lychee пишут временные файлы, а
    # база агента живёт в томе — цена отдельного разбора, не этой правки.
    cap_drop:
      - ALL
    security_opt:
      - "no-new-privileges:true"
    environment:
      AGENT_LISTEN: "0.0.0.0:9101"
      AGENT_DATABASE: /data/agent.db
      AGENT_SITES: /config/sites.json
      # Страницы, которые меряются помимо главной. Лежит рядом со списком
      # сайтов и правится так же — приложением, без перезапуска агента.
      AGENT_VITALS_PAGES: /config/vitals.json
      # Пути логов, заданные человеком. Автопоиск смотрит в известные места
      # сам, а этот файл нужен там, где логи лежат не там, где принято.
      AGENT_LOG_SOURCES: /config/logs.json
      # Состав проектов: какие домены — один клиент. Пишет приложение,
      # агент перечитывает без перезапуска. Нет файла — раскладывает домены
      # по регистрируемому сам, чтобы свод не оказался пустым.
      AGENT_PROJECTS: /config/projects.json
      # Ключевые адреса проектов: один-три на клиента. Проверяются не на
      # «отвечает ли сайт», а на то, ради чего он есть, — по профилю:
      # страница, JSON, перенаправление, текст на странице.
      AGENT_PROBES: /config/probes.json
      # Порт и домен трекинга — из .env, где их уже записала установка.
      # По ним агент спрашивает свой же Caddy, отдаётся ли скрипт аналитики:
      # соединение идёт прямо к контейнеру, а имя в сертификате при этом
      # сверяется честно.
      AGENT_EDGE_PORT: ${EDGE_PORT:?}
      AGENT_TRACKING_DOMAIN: ${TRACKING_DOMAIN:?}
      # Самоподписанный край (стенд) агент за сроком сертификата не
      # проверяет: браузер ему не доверяет по определению.
      AGENT_EDGE_SELF_SIGNED: ${SELF_SIGNED_TLS:-0}
      AGENT_HOST_PROC: /host/proc
      AGENT_HOST_ROOT: /host/root
      # Адрес базы — ради копий, и это единственное, для чего агенту нужен
      # пароль от неё: `pg_dump` без него не работает, а `docker compose
      # exec` требует сокета docker, который агенту не дадут ни ради какой
      # функции — он равен root на сервере клиента.
      #
      # Ссылка, а не секрет: подставляет её docker из `.env` с правами 600,
      # ровно как соседняя строка Umami. Дальше пароль уезжает окружением
      # дочернего процесса, а не аргументом команды: `/proc/<pid>/cmdline`
      # читает любой пользователь сервера.
      #
      # Правило «Postgres опрашивается соединением, а не разговором на его
      # языке» писалось про диагностику и там остаётся верным: чтобы понять,
      # жива ли база, пароль не нужен.
      AGENT_POSTGRES_URL: postgres://umami:${POSTGRES_PASSWORD:?}@postgres:5432/umami
    # Секреты — токен API и параметры уведомлений — приезжают файлом с
    # правами 600, а не строками в этом конфиге: его читает кто угодно.
    env_file:
      - ./agent.env
    # Логи веб-сервера клиента почти везде лежат с правами 640 root:adm.
    # Группа добавляется всегда и одна и та же, без всякого разглядывания
    # того, что стоит у клиента: мы не подстраиваемся под его веб-сервер, а
    # получаем право читать файлы, которые и так читает любой из группы adm.
    # Где этого не хватило, приложение честно скажет об этом и предложит
    # выдать доступ — по кнопке и с согласия человека.
    group_add:
      - "4"
    volumes:
      - agent-data:/data
      # Каталог, а не отдельный файл. Монтирование файла привязывает inode:
      # приложение переписывает список атомарной заменой, inode меняется, и
      # контейнер до конца жизни видит старое содержимое. С каталогом замена
      # внутри него видна сразу.
      #
      # Список правит приложение, когда агентство заводит новый домен, а
      # агент перечитывает его сам — новый сайт не стоит перезапуска.
      - ./agent-config:/config:ro
      # Агент живёт в контейнере, но рассказывать обязан про сервер.
      # Только на чтение: смотреть — да, трогать — нет.
      - /proc:/host/proc:ro
      - /:/host/root:ro
    ports:
      - "127.0.0.1:${AGENT_HOST_PORT:?}:9101"
    networks:
      - internal
    healthcheck:
      test: ["CMD", "wget", "--spider", "-q", "http://127.0.0.1:9101/health"]
      interval: 30s
      timeout: 5s
      retries: 5
      start_period: 10s

  # ── Веб-сервер ──────────────────────────────────────────────────────────
  # Единственный контейнер, видимый из интернета. Наружу проксирует только
  # трекинговые пути Umami — белым списком, а не чёрным.
  caddy:
    # Собран нами: в официальном образе Caddy нет ни модуля ограничения
    # частоты, ни модулей DNS для ACME DNS-01. Исходник образа — images/caddy
    # в репозитории.
    image: ghcr.io/zaevlad/vpsfocus-caddy:2.11.4-rl3@sha256:23090c6b238051f7b60944bc924ef0fc7c9ab26ad4000221e0c27d33a54ceae3
    restart: unless-stopped
    # Единственный контейнер, до которого дотягивается интернет, — и
    # единственный, который работает внутри себя под root: официальный образ
    # Caddy собран так. Побег из контейнера требует бага ядра или Docker, но
    # root с полным набором capabilities — самая дорогая отправная точка для
    # такого бага, а стоит нам отказ от него ничего (Б6 ревизии 2026-09-18).
    #
    # NET_BIND_SERVICE возвращается один: EDGE_PORT по умолчанию 443, а с
    # пустым набором прав порт ниже 1024 не занять даже root. Остальное
    # Caddy не нужно: он пишет только в /data и /config, и оба — тома.
    cap_drop:
      - ALL
    cap_add:
      - NET_BIND_SERVICE
    security_opt:
      - "no-new-privileges:true"
    # Корень контейнера только на чтение: подменить в нём бинарник или
    # подложить модуль не выйдет даже после удачного взлома.
    read_only: true
    # Caddy держит в /tmp тела запросов, не поместившиеся в память. Том для
    # них не нужен — они живут секунды.
    tmpfs:
      - /tmp
    ports:
      # Один порт, и тот выбранный при установке. Раньше здесь стояли 80 и
      # 443 — на VPS, где уже работает сайт клиента, они заняты его
      # веб-сервером, и претендовать на них мы не будем.
      #
      # Порт 80 не публикуется вообще: перенаправлять с него некуда, а
      # подтверждение домена идёт через DNS, а не через порт.
      #
      # Только TCP. HTTP/3 Caddy умеет, но это ещё один занятый порт на
      # чужом сервере ради выигрыша, которого трекинг-пиксель не заметит.
      - "${EDGE_PORT:?}:${EDGE_PORT:?}"
    environment:
      # Секреты DNS-провайдера приезжают из .env (права 600), а не строками
      # в этом файле: его читает кто угодно. В Caddyfile стоят ссылки вида
      # {env.DNS_API_TOKEN} — сам токен там тоже не появляется.
      #
      # Имена AWS_* штатные: модуль route53 читает их сам.
      DNS_API_TOKEN: ${DNS_API_TOKEN:-}
      AWS_ACCESS_KEY_ID: ${AWS_ACCESS_KEY_ID:-}
      AWS_SECRET_ACCESS_KEY: ${AWS_SECRET_ACCESS_KEY:-}
      AWS_REGION: ${AWS_REGION:-}
      ACME_DNS_USERNAME: ${ACME_DNS_USERNAME:-}
      ACME_DNS_PASSWORD: ${ACME_DNS_PASSWORD:-}
      ACME_DNS_SUBDOMAIN: ${ACME_DNS_SUBDOMAIN:-}
      ACME_DNS_SERVER_URL: ${ACME_DNS_SERVER_URL:-}
    volumes:
      - ./Caddyfile:/etc/caddy/Caddyfile:ro
      # Сертификат, который человек ввёл в приложение сам (правка 1б).
      #
      # Своя копия в каталоге стека, а не ссылка на файлы certbot клиента:
      # стек обязан оставаться самостоятельным. Чужой сертификат может
      # обновляться, ломаться и переезжать — отсюда мы за ним не ходим.
      # Каталог только на чтение и пустует, пока сертификат выпускает сам
      # Caddy (обычный случай): Caddyfile ссылается на эти файлы, только
      # когда выбран режим своего сертификата.
      - ./tls:/etc/caddy/tls:ro
      # Сертификаты переживают пересоздание контейнера. Иначе каждый
      # перезапуск — новый запрос к Let's Encrypt и быстрый выход на лимит.
      - caddy-data:/data
      - caddy-config:/config
    networks:
      - internal
    depends_on:
      umami:
        condition: service_started

# Своя сеть и свои тома: ничего общего с тем, что уже крутится у клиента.
networks:
  internal:
    driver: bridge

volumes:
  postgres-data:
  caddy-data:
  caddy-config:
  agent-data:
