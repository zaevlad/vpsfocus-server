# Переменные стека. Права 600, владелец root.
#
# Здесь лежат все секреты установки. Сгенерированы на машине агентства, живут
# в хранилище ОС рядом с SSH-ключами и на backend разработчика не уходят
# никогда. Пароли состоят только из букв и цифр — они попадают в строку
# подключения к Postgres, и любой символ, требующий экранирования в URL,
# рано или поздно ломает установку в неочевидном месте.
#
# docker compose читает этот файл сам и подставляет значения в
# docker-compose.yml. install.sh берёт их оттуда же.

# Имя проекта compose и версия бандла, которым поставлен стек.
STACK_NAME={{ STACK_NAME }}
STACK_VERSION={{ STACK_VERSION }}

# Домен, на который агентство направило этот сервер.
TRACKING_DOMAIN={{ TRACKING_DOMAIN }}

# Порт, которым стек смотрит в интернет.
#
# Не 443 жёстко: на VPS, где уже работает сайт клиента, 443 занят его
# веб-сервером, а отбирать чужой порт мы не будем никогда. Порт выбирается
# при установке из списка, совместимого с проксированием Cloudflare, и
# записывается здесь — обновление обязано оставить стек на том же порту,
# иначе трекинг-сниппет на сайте клиента станет ссылаться в пустоту.
EDGE_PORT={{ EDGE_PORT }}

# Добавить разрешающее правило в файрвол сервера для выбранного порта.
#
# Единственное изменение, которое установка делает за пределами своего
# каталога и Docker, — поэтому оно спрашивается в приложении, а не решается
# за пользователя. Правило только разрешающее и только для нашего порта;
# откат его снимает. Сырые nftables и iptables установка не правит вовсе.
OPEN_FIREWALL={{ OPEN_FIREWALL }}

# Как выпускается сертификат. Записано здесь, потому что обновление
# пересобирает Caddyfile заново: не помни мы этих значений, обновление
# на стенде подменяло бы самоподписанный сертификат запросом к Let's Encrypt,
# который на локальном домене никогда не выполнится.
ACME_EMAIL={{ ACME_EMAIL }}
SELF_SIGNED_TLS={{ SELF_SIGNED_TLS }}

# Откуда берётся сертификат — строка `TLS_MODE=file` в конце этого файла.
# Её нет — сертификат выпускает сам Caddy (обычный случай); она есть —
# сертификат ввёл человек, и он лежит в tls/ рядом с этим файлом.
#
# Значением, а не догадкой по наличию файлов: сервер — источник правды о
# том, как стек настроен, и обновление обязано собрать Caddyfile тем же
# способом, каким его собрала установка.
#
# Строку дописывает приложение, а не плейсхолдер здесь: подстановка
# строгая, и незнакомый плейсхолдер уронил бы установку и обновление у
# каждой сборки приложения, вышедшей до 0.17.0, — backend отдаёт самую
# свежую версию бандла всем.

# ── Подтверждение домена через DNS (ACME DNS-01) ──────────────────────────
# Нужно, когда порт 443 занят: подтвердить владение доменом через занятый
# порт нельзя. Пусто — сертификат выпускается обычным путём, через 443.
#
# Провайдер: cloudflare, route53, digitalocean, acmedns. Последний — наш
# запасной ответчик на backend, для случая, когда API-доступа к своему DNS
# у агентства нет.
DNS_PROVIDER={{ DNS_PROVIDER }}

# Токен API DNS-провайдера: Cloudflare и DigitalOcean. Это секрет ровно того
# же уровня, что пароль базы, и уезжает он сюда, а не на наш backend.
#
# Токен стоит выдавать по минимуму: право правки DNS одной зоны. Тогда
# сервер клиента, даже будучи взломан, не даёт доступа ко всему DNS
# агентства.
DNS_API_TOKEN={{ DNS_API_TOKEN }}

# Route53 читает свои переменные сам, штатными именами AWS.
AWS_ACCESS_KEY_ID={{ AWS_ACCESS_KEY_ID }}
AWS_SECRET_ACCESS_KEY={{ AWS_SECRET_ACCESS_KEY }}
AWS_REGION={{ AWS_REGION }}

# Запасной путь: на DNS-challenge отвечает backend vpsFocus. Агентство один
# раз создаёт CNAME с `_acme-challenge` своего домена на выданное здесь имя,
# и дальше продление идёт само, без доступа к DNS-панели.
#
# Это единственное место, где бесплатная часть продукта опирается на нашу
# инфраструктуру, и только для выпуска сертификата раз в 60–90 дней. Трафик
# посетителей и данные аналитики через наш сервер не проходят никогда.
ACME_DNS_USERNAME={{ ACME_DNS_USERNAME }}
ACME_DNS_PASSWORD={{ ACME_DNS_PASSWORD }}
ACME_DNS_SUBDOMAIN={{ ACME_DNS_SUBDOMAIN }}
ACME_DNS_SERVER_URL={{ ACME_DNS_SERVER_URL }}

# Порт админки Umami на петле сервера. Наружу не публикуется: приложение
# ходит в неё через SSH-туннель.
UMAMI_HOST_PORT={{ UMAMI_HOST_PORT }}

# Пароль базы. Подставляется в DATABASE_URL Umami.
POSTGRES_PASSWORD={{ POSTGRES_PASSWORD }}

# Ключ подписи сессий Umami. Смена ключа разлогинивает всех.
UMAMI_APP_SECRET={{ UMAMI_APP_SECRET }}

# Учётка админа Umami. Образ создаёт admin/umami при первом запуске, и
# install.sh меняет пароль сразу же: публичный трекинг-домен с дефолтным
# паролем админки — окно, которое нельзя оставлять открытым ни на минуту.
UMAMI_ADMIN_USERNAME={{ UMAMI_ADMIN_USERNAME }}
UMAMI_ADMIN_PASSWORD={{ UMAMI_ADMIN_PASSWORD }}

# Токен доступа к API агента лежит не здесь, а в agent.env: его читает
# контейнер агента, и держать секрет в двух файлах незачем.

# Порт API агента на петле сервера. Наружу не публикуется, как и Umami:
# приложение ходит к нему через SSH-туннель.
AGENT_HOST_PORT={{ AGENT_HOST_PORT }}
