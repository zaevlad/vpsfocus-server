# Caddy на VPS клиента.
#
# Единственный контейнер стека, видимый из интернета. Наружу проксируются
# ТОЛЬКО трекинговые пути Umami, и белым списком, а не чёрным: чёрный список
# — это перечисление того, что вспомнили, и он устаревает с каждым релизом
# Umami. Всё, чего нет в списке, получает 404, включая /login, /api/auth и
# любой служебный путь.
#
# С версии 0.2.0 порт не жёсткий. Раньше здесь подразумевались 80 и 443, а
# на VPS, где уже работает сайт клиента, они почти всегда заняты. Теперь
# адрес сайта приезжает целиком, вместе с портом, и никаких претензий на
# чужие порты у стека нет (решение 2026-08-28).
#
# Подставляется приложением. Имена перечислены БЕЗ двойных скобок нарочно:
# подстановка не разбирает, комментарий перед ней или нет, и многострочное
# значение, попав в комментарий, разорвало бы его — вторая строка блока
# оказалась бы конфигом верхнего уровня. Стоило одного пойманного бага.
#
#   SITE_ADDRESS        адрес с портом: https://stats.example.com:2096
#                       (для 443 порт не указывается — ссылка на трекер
#                       тогда выглядит как обычно)
#   ACME_EMAIL_LINE     пусто или `email ops@example.com` — почта для писем
#                       Let's Encrypt об истечении сертификата
#   TLS_BLOCK           как выпускается сертификат: пусто — автоматически
#                       (только когда порт 443 свободен и challenge проходит
#                       по нему), `tls internal` — самоподписанный для
#                       стенда, либо блок с `dns <провайдер>` для DNS-01
#   RATE_LIMIT_EVENTS   сколько событий с одного адреса за окно
#   RATE_LIMIT_WINDOW   длина окна
#
# Пустой строки между этим комментарием и блоком ниже нет нарочно: `caddy
# fmt` её убирает, а несогласие с ним Caddy печатает в лог клиента при
# каждом старте и каждой перезагрузке конфига.
{
	# Порядок обязателен: rate_limit — сторонний модуль, и без явного места в
	# конвейере Caddy не знает, когда его выполнять.
	order rate_limit before basicauth

	# Админский API Caddy слушает 127.0.0.1:2019 внутри контейнера и наружу не
	# публикуется. Выключать его нельзя: через него идёт перезагрузка конфига
	# при добавлении домена.
	admin 127.0.0.1:2019

	# Порт 80 наружу не публикуется вовсе, поэтому и перенаправлять с него
	# некуда. Отключаем явно: иначе Caddy поднимает слушателя, до которого
	# никто никогда не дойдёт, и пишет об этом в лог при каждом старте.
	#
	# Само автоматическое получение сертификата это не выключает — только
	# редиректы.
	auto_https disable_redirects

	# Почта для писем Let's Encrypt об истечении сертификата. Стоит здесь, а
	# не последней строкой блока, и без пустой строки после: значение бывает
	# пустым, а пустая строка перед `}` — это несогласие с `caddy fmt`, о
	# котором Caddy пишет в лог клиента при каждом старте и перезагрузке.
	{{ ACME_EMAIL_LINE }}
	# Настоящий адрес посетителя за прокси Cloudflare (Б9 ревизии
	# 2026-09-18). Агентства держат DNS в Cloudflare с включённым
	# проксированием — ради этого и выбран список портов установки. За
	# прокси адрес соединения — это адрес Cloudflare, и все посетители сайта
	# делят один счётчик ограничения частоты ниже: сайт с одним просмотром в
	# секунду теряет аналитику молча.
	#
	# Доверять заголовку от кого попало нельзя — его подделает кто угодно и
	# обойдёт ограничение. Поэтому список закрытый: диапазоны Cloudflare с
	# https://www.cloudflare.com/ips-v4 и /ips-v6, сняты 2026-09-21.
	# Обновляются новой версией бандла, как и версии образов.
	#
	# Стек без Cloudflare этим не меняется ничем: запрос приходит не с этих
	# адресов, заголовок не читается, и `{client_ip}` равен адресу
	# соединения. Устаревший список даёт ровно то же самое — не хуже, чем
	# было.
	servers {
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		# CF-Connecting-IP первым: Cloudflare сам кладёт в него один адрес —
		# адрес посетителя. X-Forwarded-For к этому моменту может нести
		# цепочку, дописанную ещё до Cloudflare.
		client_ip_headers CF-Connecting-IP X-Forwarded-For
	}
}

{{ SITE_ADDRESS }} {
	# Как выпускается сертификат. Комментарий здесь не для красоты: значение
	# ниже бывает пустым (автоматический выпуск через порт 443), а пустая
	# строка сразу после `{` — несогласие с `caddy fmt`, о котором Caddy
	# пишет в лог клиента при каждом старте. По той же причине после него
	# нет пустой строки.
	{{ TLS_BLOCK }}
	header {
		# HSTS здесь нет нарочно (Б3 ревизии 2026-09-18). Политика браузера
		# привязана к хосту, а не к порту, а трекинговый домен бывает самим
		# сайтом клиента — https://example.com:2096. Заголовок отсюда год
		# заставлял бы браузеры посетителей ходить на сайт клиента только по
		# https и на любом порту, а с includeSubDomains — ещё и на все его
		# поддомены: http-only поддомены и панели на своих портах ломались бы
		# там, куда с сервера не дотянуться. Нужен ли хосту HSTS, решает
		# веб-сервер клиента, а не наш порт. Понижать здесь и нечего: скрипт и
		# приём событий отдаются только по https.
		#
		# И max-age=0 тоже нет, хотя он стёр бы политику, отданную бандлами до
		# 0.14.0: на apex он при каждой загрузке скрипта стирал бы и собственный
		# HSTS сайта клиента.
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		# Версия Caddy наружу не нужна: это подсказка тому, кто ищет уязвимость.
		-Server
	}

	# Скрипт трекинга: его тянет браузер посетителя сайта клиента.
	@tracker path /script.js

	# Приём событий. Единственный путь, куда пишут снаружи.
	@collect path /api/send

	handle @tracker {
		reverse_proxy umami:3000
	}

	handle @collect {
		# Без ограничения частоты один скрипт набивает базу клиента событиями
		# быстрее, чем её успеют заметить. Ключ — адрес посетителя, а не
		# адрес соединения: за прокси Cloudflare это разные вещи, и второе
		# означало бы один счётчик на весь сайт (Б9). Без прокси `{client_ip}`
		# и есть адрес соединения — там ничего не меняется.
		rate_limit {
			zone collect {
				key {client_ip}
				events {{ RATE_LIMIT_EVENTS }}
				window {{ RATE_LIMIT_WINDOW }}
			}
		}

		# Событие Umami — это несколько сотен байт. Всё, что заметно больше,
		# отправлено не трекером.
		request_body {
			max_size 16KB
		}

		reverse_proxy umami:3000
	}

	# Всё остальное не существует. Именно 404, а не 403: отвечать «сюда
	# нельзя» значит подтверждать, что там что-то есть.
	handle {
		respond 404
	}

	log {
		output stderr
		format console
	}
}
