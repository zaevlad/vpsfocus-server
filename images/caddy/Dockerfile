# Caddy с ограничением частоты запросов и модулями DNS-01.
#
# Зачем свой образ. Трекинговый эндпоинт Umami — единственное, что стек
# показывает интернету, и без ограничения частоты его набивают событиями
# быстрее, чем клиент это заметит: база растёт, диск кончается. В официальном
# образе Caddy модуля rate_limit нет — он сторонний, и добавить его можно
# только пересборкой (`caddy list-modules` это подтверждает).
#
# Вторая причина, появившаяся в спринте 14: сертификат выпускается через
# ACME DNS-01, а не через занятый порт. Модулей DNS в официальном образе нет
# по той же причине — они сторонние, по одному на провайдера.
#
# Почему собираем у себя, а не на VPS клиента. Сборка тянет модули Go с
# proxy.golang.org. На сервере агентства с закрытым исходящим трафиком или за
# корпоративным прокси установка падала бы на ровном месте — и падала бы уже
# после того, как мы поставили Docker. Собранный образ уезжает в реестр, а
# клиентский сервер делает обычный docker pull.
#
# Собирать и публиковать: images/caddy/build.ps1 (с трека Q — GitHub Actions
# открытого репозитория, `build-images.yml`, с аттестацией происхождения).

# Базовые образы — по дайджесту индекса, а не по тегу (трек Q, П2): тег в
# реестре переписывают, и две сборки из одного коммита дали бы разный
# образ. Тег оставлен для чтения; обновить базу — сменить и тег, и дайджест
# (`docker buildx imagetools inspect <тег>`).
#
# Мультиархитектурность обязательна: ARM-серверы обычны у Hetzner и Oracle
# Cloud, и dry-run проверяет архитектуру именно поэтому.

# --platform=$BUILDPLATFORM обязателен. Без него BuildKit запускает эту
# стадию под архитектуру образа, то есть arm64 собирается под эмуляцией
# QEMU, — а Go под QEMU в длинных сборках зависает намертво: процессор
# простаивает, вывода нет, ошибки нет. Проверено 2026-09-21: сборка встала
# на `xcaddy build` под arm64 и не сдвинулась за сорок минут.
#
# Вместо эмуляции — кросс-компиляция: стадия идёт на архитектуре машины
# сборки, а целевую задают GOOS и GOARCH ниже. Go умеет это без тулчейнов,
# и получается это в разы быстрее эмуляции.
FROM --platform=$BUILDPLATFORM caddy:2.11.4-builder-alpine@sha256:0aa610043dab5da82ad0a0268e46bb852785e6f5160f12f1c6fe3f42903d7e1b AS builder

# Заполняются BuildKit из `--platform` у самой сборки.
ARG TARGETOS=linux
ARG TARGETARCH=amd64

# Запросы к базе контрольных сумм идут через прокси модулей. Прямой доступ к
# sum.golang.org рвётся по таймауту на обеих машинах разработки, а проверка
# сумм при этом сохраняется — прокси отдаёт те же подписанные записи.
ENV GOPROXY=https://proxy.golang.org

# CGO выключен: с ним кросс-сборка потребовала бы тулчейна на каждую
# архитектуру, а Caddy в нём не нуждается. xcaddy передаёт эти переменные
# в `go build`, которым и собирает.
ENV CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH}

# Модули DNS едут все сразу, а не по одному образу на провайдера: образ один
# на все установки, и выбор провайдера — это строка в Caddyfile, а не другой
# образ. Стартовый список взят из решения 2026-08-28.
#
#   cloudflare    самый частый бесплатный DNS у агентств
#   route53       AWS
#   digitalocean  DigitalOcean
#   acmedns       запасной путь: на challenge отвечает backend vpsFocus,
#                 когда API-доступа к DNS у агентства нет
#
# Каждый модуль — с версией (трек Q, П2): без неё xcaddy берёт то, что лежит
# в модуле в момент сборки, и сборка из одного коммита не повторяется.
# Версии сняты `caddy build-info` с образа 2.11.4-rl2 — код тот же, что
# уже стоит у клиентов. Зависимости модулей закрепляет go.sum их версий.
RUN xcaddy build \
    --with github.com/mholt/caddy-ratelimit@v0.1.0 \
    --with github.com/caddy-dns/cloudflare@v0.2.4 \
    --with github.com/caddy-dns/route53@v1.6.2 \
    --with github.com/caddy-dns/digitalocean@v0.0.0-20250606074528-04bde2867106 \
    --with github.com/caddy-dns/acmedns@v0.7.0

FROM caddy:2.11.4-alpine@sha256:6aeddd44c3078b0f9a35206472a11420648a79c184603ef95957d0a20044cb2b

COPY --from=builder /usr/bin/caddy /usr/bin/caddy
